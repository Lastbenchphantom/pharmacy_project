{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "receiptOcr.js",
          "node_modules/tesseract.js/**",
          "node_modules/tesseract.js-core/**",
          "node_modules/pdf-parse/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
