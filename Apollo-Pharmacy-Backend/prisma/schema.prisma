generator client {
	provider      = "prisma-client-js"
	binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model Medicine {
	id            String   @id @default(cuid())
	brandName     String
	genericName   String   @default("")
	manufacturer  String   @default("")
	strength      String   @default("")
	dosageForm    String   @default("Other")
	description   String?
	availableQty  Int      @default(0)
	singlePiecePrice Float  @default(0) @map("piece_price")
	fullBoxPrice  Float    @default(0) @map("box_price")
	isActive      Boolean  @default(true)
	createdAt     DateTime @default(now())
	updatedAt     DateTime @updatedAt

	batches            StockBatch[]
	stockTransactions  StockTransaction[]
	receiptItems       StockReceiptItem[]

	@@index([brandName])
	@@index([genericName])
	@@index([manufacturer])
	@@index([strength])
	@@index([dosageForm])
	@@index([availableQty])
	@@index([isActive])
}

model Appointment {
	id          String   @id @default(cuid())
	patientName String
	phoneNumber String
	doctorName  String
	timeSlot    String
	email       String
	status      String   @default("PENDING")
	note        String?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@index([doctorName, timeSlot])
	@@index([phoneNumber])
}

model StockReceipt {
	id             String   @id @default(cuid())
	fileName       String
	mimeType       String
	fileHash       String   @unique
	fileData       Bytes
	status         String   @default("PROCESSING")
	uploadedBy     String
	uploadedAt     DateTime @default(now())
	processedAt    DateTime?
	confirmedBy    String?
	confirmedAt    DateTime?
	errorMessage   String?
	supplierName   String?
	invoiceNumber  String?
	purchaseDate   String?
	subtotal       Float?
	discount       Float?
	tax            Float?
	total          Float?

	items          StockReceiptItem[]
	transactions   StockTransaction[]

	@@index([status, uploadedAt])
}

model StockReceiptItem {
	id             String   @id @default(cuid())
	receiptId      String
	medicineName   String
	brandName      String?
	genericName    String?
	strength       String?
	dosageForm     String?
	manufacturer   String?
	packSize       String?
	quantity       Int?
	unitPrice      Float?
	totalPrice     Float?
	batchNumber    String?
	expiryDate     String?
	confidence     Float    @default(0)
	matchStatus    String   @default("UNMATCHED")
	matchedMedicineId String?

	receipt          StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
	matchedMedicine  Medicine?    @relation(fields: [matchedMedicineId], references: [id], onDelete: SetNull)

	@@index([receiptId])
	@@index([matchedMedicineId])
}

model StockTransaction {
	id             String   @id @default(cuid())
	receiptId      String?
	medicineId     String
	batchId        String?
	transactionType String
	quantity       Int
	previousStock  Int
	newStock       Int
	batchNumber    String?
	expiryDate     String?
	reason         String?
	createdBy      String
	createdAt      DateTime @default(now())

	receipt        StockReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
	medicine       Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)

	@@index([medicineId, createdAt])
	@@index([receiptId])
	@@index([transactionType, createdAt])
	@@index([batchId])
}

model StockBatch {
	id             String    @id @default(cuid())
	medicineId     String
	batchNumber    String?
	expiryDate     DateTime?
	quantity       Int       @default(0)
	purchasePrice  Float?
	sellingPrice   Float?
	createdAt      DateTime  @default(now())
	updatedAt      DateTime  @updatedAt
	medicine       Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)

	@@unique([medicineId, batchNumber])
	@@index([expiryDate])
	@@index([medicineId, expiryDate])
}

model PushSubscription {
	id        String   @id @default(cuid())
	endpoint  String   @unique
	p256dh    String
	auth      String
	userAgent String?
	createdBy String?
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([createdAt])
}
